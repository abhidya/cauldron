#!/usr/bin/env bash
# sync-plugin-schema [--check]
#
# The Claude Code plugin (claude-code/cauldron/) ships a COPY of the published
# soup schema (schema/soup/workspace-v6/) in its own schema/ directory, so an
# agent on a machine without this repository can read it. This script makes
# that copy; it never edits a schema file (the .json files are generated from
# the Rust grammar, see schema/soup/workspace-v6/README.md).
#
#   scripts/sync-plugin-schema           copy every file of the published dir
#   scripts/sync-plugin-schema --check   change nothing; exit 1 if the copy
#                                         differs from the published dir
#
# A file in the copy that the published dir does not have is never deleted
# here: both modes report it and exit 1, and a human removes it.
#
# The same comparison runs in the spine crate's tests
# (`cargo test -p spine --lib schema_publish`), so CI fails on drift too.
#
# Exit: 0 in step · 1 drift (--check) or a stray file · 2 usage or a missing dir.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
src="$root/schema/soup/workspace-v6"
dst="$root/claude-code/cauldron/schema"

mode="copy"
case "${1:-}" in
  "") ;;
  --check) mode="check" ;;
  *) echo "usage: scripts/sync-plugin-schema [--check]" >&2; exit 2 ;;
esac

if [ ! -d "$src" ]; then
  echo "sync-plugin-schema: no published schema at $src" >&2
  exit 2
fi

status=0
if [ "$mode" = "copy" ]; then
  mkdir -p "$dst"
fi
if [ ! -d "$dst" ]; then
  echo "sync-plugin-schema: no plugin copy at $dst (run without --check to make it)" >&2
  exit 1
fi

for f in "$src"/*; do
  name="$(basename "$f")"
  if [ "$mode" = "copy" ]; then
    cp "$f" "$dst/$name"
  elif ! cmp -s "$f" "$dst/$name"; then
    echo "sync-plugin-schema: claude-code/cauldron/schema/$name differs from schema/soup/workspace-v6/$name" >&2
    status=1
  fi
done

for f in "$dst"/*; do
  name="$(basename "$f")"
  if [ ! -e "$src/$name" ]; then
    echo "sync-plugin-schema: claude-code/cauldron/schema/$name is not in the published schema; remove it" >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  [ "$mode" = "check" ] && echo "sync-plugin-schema: the plugin's copy drifted; run scripts/sync-plugin-schema" >&2
  exit 1
fi
[ "$mode" = "copy" ] && echo "sync-plugin-schema: copied $(ls "$src" | wc -l | tr -d ' ') files to claude-code/cauldron/schema/"
exit 0
